}

@article{dupont2022normalitycriteriafor,
  title = {Normality criteria for monomial ideals},
  author = {Luis A. Dupont and Humberto Muñoz-George and Rafael H. Villarreal},
  year = {2022},
  url = {https://arxiv.org/abs/2208.08588v2},
  abstract = {In this paper we study the normality of monomial ideals using linear programming and graph theory. We give normality criteria for monomial ideals, for ideals generated by monomials of degree two, and for edge ideals of graphs and clutters and their ideals of covers.},
}

@article{huang2022anoteon,
  title = {A note on a new result related to Chartrand, Kaigars and Lick's theorem},
  author = {Zhong Huang and Meng Ji},
  year = {2022},
  url = {https://arxiv.org/abs/2212.04637v6},
  abstract = {In this note, we prove a theorem covering Chartrand, Kaigars, and Lick's theorem in [Proc. Amer. Math. Soc. 32 (1972), 63-68]. As an application, we give a simpler proof of theorem proved by Mader [J. Graph Theory 65 (2010), 61-69. (Theorem 1)].},
}

@article{sa2021orderinthe,
  title = {Order in the chaos with examples from graph theory},
  author = {Zoltán Kása},
  year = {2021},
  url = {https://arxiv.org/abs/2112.02362v2},
  abstract = {In randomly created structures (be they natural or artificial) very often there exist ordered substructures. In this Hungarian language scientific essay we will present some of such structures in graph theory. E.g. Rédei's theorem, Ramsey theory, Turán's problem, Hamiltonian cycles in De Bruijn graphs.},
}

@article{akita2023parityconditionsfor,
