}

@article{lalin2023onthedistribution,
  title = {On the distribution of eigenvalues in families of Cayley graphs},
  author = {Matilde Lalin and Anwesh Ray},
  year = {2023},
  url = {https://arxiv.org/abs/2303.11822v2},
  abstract = {We consider the family of undirected Cayley graphs associated with odd cyclic groups, and study statistics for the eigenvalues in their spectra. Our results are motivated by analogies between arithmetic geometry and graph theory.},
}

@article{roucairol2022refutationofspectral,
  title = {Refutation of Spectral Graph Theory Conjectures with Monte Carlo Search},
  author = {Milo Roucairol and Tristan Cazenave},
  year = {2022},
